# Only runtime sources and locked dependencies enter the build context.
**
!app/
!app/**
!public/
!public/**
!docker/
!docker/**
!composer.json
!composer.lock
!spark
!docker-entrypoint.sh
!Dockerfile
!.dockerignore
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.log
**/*debug*.txt
public/test_*
public/debug_*
public/check_*
public/fix_*
public/repair_*
public/*.sql
